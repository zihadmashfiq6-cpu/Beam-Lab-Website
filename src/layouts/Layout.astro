---
import '../styles/global.css';
import site from '../data/site.json';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = '/og-image.svg' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';

const nav = [
  { href: '/research', label: 'Research' },
  { href: '/projects', label: 'Projects' },
  { href: '/instruments', label: 'Instruments' },
  { href: '/people', label: 'People' },
  { href: '/publications', label: 'Publications' },
  { href: '/news', label: 'News' },
  { href: '/messages', label: 'Messages' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-white focus:px-3 focus:py-2">Skip to content</a>

    <header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-transparent>
      <div class="container-x flex h-16 items-center justify-between gap-4">
        <a href={url('/')} class="flex items-center gap-2.5 font-display text-lg font-bold text-white" aria-label={`${site.name} home`}>
          <img src={url('/favicon.svg')} alt="" width="32" height="32" class="h-8 w-8" />
          <span>BEaM<span class="text-signal-400">Lab</span></span>
        </a>

        <nav class="hidden lg:block" aria-label="Main">
          <ul class="flex items-center gap-1">
            {nav.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  class:list={[
                    'rounded-full px-3 py-1.5 text-sm font-medium transition',
                    isActive(item.href) ? 'bg-white/15 text-white' : 'text-white/75 hover:bg-white/10 hover:text-white',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-1">
          <button id="theme-toggle" type="button" class="rounded-full p-2 text-white/80 hover:bg-white/10 hover:text-white" aria-label="Toggle dark mode">
            <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
            <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <button id="menu-toggle" type="button" class="rounded-full p-2 text-white/80 hover:bg-white/10 lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </div>
      </div>

      <nav id="mobile-nav" class="hidden border-t border-white/10 bg-navy-950/95 backdrop-blur lg:hidden" aria-label="Mobile">
        <ul class="container-x grid gap-1 py-3">
          {nav.map((item) => (
            <li>
              <a href={url(item.href)} class:list={['block rounded-lg px-3 py-2 text-base', isActive(item.href) ? 'bg-white/10 text-white' : 'text-white/80']}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="bg-navy-950 text-slate-400">
      <div class="container-x grid gap-10 py-14 md:grid-cols-3">
        <div>
          <p class="font-display text-xl font-bold text-white">BEaM<span class="text-signal-400">Lab</span></p>
          <p class="mt-3 max-w-xs text-sm leading-relaxed">{site.tagline}.</p>
        </div>
        <div class="text-sm">
          <p class="mb-3 font-semibold text-white">Visit us</p>
          <address class="not-italic leading-relaxed">
            {site.department}<br />
            {site.address.map((l) => (<>{l}<br /></>))}
          </address>
        </div>
        <div class="text-sm">
          <p class="mb-3 font-semibold text-white">Explore</p>
          <ul class="grid grid-cols-2 gap-y-2">
            {nav.map((item) => (<li><a href={url(item.href)} class="hover:text-signal-400">{item.label}</a></li>))}
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <p class="container-x py-5 text-xs">© {new Date().getFullYear()} {site.name}, {site.university}. All rights reserved.</p>
      </div>
    </footer>

    <script>
      // Theme toggle
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });

      // Mobile menu
      const menuBtn = document.getElementById('menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      menuBtn?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('hidden') === false;
        menuBtn.setAttribute('aria-expanded', String(open));
      });

      // Header background on scroll
      const header = document.getElementById('site-header');
      const onScroll = () => {
        const solid = window.scrollY > 24 || !mobileNav?.classList.contains('hidden');
        header?.classList.toggle('bg-navy-950/90', solid);
        header?.classList.toggle('backdrop-blur', solid);
        header?.classList.toggle('shadow-lg', solid);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      menuBtn?.addEventListener('click', onScroll);
      onScroll();

      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
