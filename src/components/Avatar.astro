---
import { url } from '../lib/url';

interface Props {
  name: string;
  photo?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { name, photo, size = 'md' } = Astro.props;
const initials = name
  .replace(/^Dr\.\s*/, '')
  .split(/\s+/)
  .map((p) => p[0])
  .slice(0, 2)
  .join('');
const sizes = { sm: 'h-12 w-12 text-base', md: 'h-20 w-20 text-2xl', lg: 'h-28 w-28 text-3xl' };
---

{
  photo ? (
    <img src={url(photo)} alt={`Portrait of ${name}`} class:list={['rounded-full object-cover ring-4 ring-white dark:ring-navy-900', sizes[size]]} loading="lazy" />
  ) : (
    <div
      class:list={[
        'flex items-center justify-center rounded-full bg-gradient-to-br from-navy-600 to-signal-500 font-display font-bold text-white ring-4 ring-white dark:ring-navy-900',
        sizes[size],
      ]}
      role="img"
      aria-label={`${name} (photo coming soon)`}
    >
      {initials}
    </div>
  )
}
