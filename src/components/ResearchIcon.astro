---
interface Props { name: string; class?: string }
const { name, class: cls = 'h-6 w-6' } = Astro.props;
---

<svg class={cls} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'scan' && (<><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2" /><path d="M7 12h10" /><circle cx="8" cy="8" r=".6" fill="currentColor" /><circle cx="15" cy="9" r=".6" fill="currentColor" /><circle cx="10" cy="16" r=".6" fill="currentColor" /><circle cx="16" cy="15" r=".6" fill="currentColor" /></>)}
  {name === 'bridge' && (<><path d="M2 16h20M4 16V9M20 16V9M2 9c4 0 6-4 10-4s6 4 10 4" /><path d="M8 16v-4.5M12 16V5M16 16v-4.5" /></>)}
  {name === 'cube' && (<><path d="m12 2 9 5v10l-9 5-9-5V7l9-5Z" /><path d="m3 7 9 5 9-5M12 12v10" /></>)}
  {name === 'crane' && (<><path d="M6 21V4l14 3M6 7h14M4 21h6M17 7v5" /><path d="M15 12h4v3h-4z" /></>)}
</svg>
