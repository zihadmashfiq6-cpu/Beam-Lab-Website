---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-950 pt-32 pb-16 sm:pb-20">
  <div class="bg-grid absolute inset-0 [mask-image:radial-gradient(ellipse_at_top,black,transparent_75%)]" aria-hidden="true"></div>
  <div class="absolute -top-24 right-0 h-72 w-72 rounded-full bg-signal-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-24 left-10 h-72 w-72 rounded-full bg-navy-500/30 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative">
    {eyebrow && <p class="eyebrow !text-signal-400">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-bold !text-white sm:text-5xl">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">{intro}</p>}
    <slot />
  </div>
</section>
