---
// A single popup player shared by every element with [data-video-id].
// The YouTube iframe is only created when someone clicks, so the page stays fast.
---

<dialog
  id="video-modal"
  class="m-auto w-[min(960px,calc(100vw-2rem))] overflow-visible bg-transparent p-0 backdrop:bg-navy-950/85 backdrop:backdrop-blur-sm"
  aria-label="Video player"
>
  <div class="relative">
    <button
      type="button"
      data-close
      class="absolute -top-12 right-0 rounded-full bg-white/10 p-2 text-white hover:bg-white/20"
      aria-label="Close video"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <div id="video-frame" class="aspect-video w-full overflow-hidden rounded-2xl bg-black shadow-2xl"></div>
    <p id="video-caption" class="mt-3 text-center text-sm text-white/80"></p>
  </div>
</dialog>

<script>
  const modal = document.getElementById('video-modal') as HTMLDialogElement | null;
  const frame = document.getElementById('video-frame');
  const caption = document.getElementById('video-caption');

  const close = () => {
    modal?.close();
  };
  modal?.addEventListener('close', () => { if (frame) frame.innerHTML = ''; });
  modal?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === modal || t.closest('[data-close]')) close();
  });

  document.querySelectorAll<HTMLElement>('[data-video-open]').forEach((el) => {
    el.addEventListener('click', () => {
      if (!modal || !frame) return;
      const id = el.dataset.videoId;
      const title = el.dataset.videoTitle ?? 'Video';
      frame.innerHTML = id
        ? `<iframe class="h-full w-full" src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0" title="${title.replace(/"/g, '&quot;')}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`
        : `<div class="flex h-full w-full flex-col items-center justify-center gap-2 bg-gradient-to-br from-navy-800 to-navy-950 text-white"><p class="font-display text-xl">Video coming soon</p><p class="text-sm text-white/60">Add a YouTube ID in src/data/messages.json</p></div>`;
      if (caption) caption.textContent = title;
      modal.showModal();
    });
  });
</script>
