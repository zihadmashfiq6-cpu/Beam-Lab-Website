---
interface Props { name: string; class?: string }
const { name, class: cls = 'h-6 w-6' } = Astro.props;
---

<svg class={cls} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'scanner' && (<><rect x="8" y="3" width="8" height="9" rx="2" /><circle cx="12" cy="7.5" r="2" /><path d="M12 12v3M12 15l-5 6M12 15l5 6M12 15v6" /></>)}
  {name === 'vehicle' && (<><path d="M3 16V11l2-4h10l3 4h3v5H3Z" /><circle cx="7" cy="17" r="2" /><circle cx="17" cy="17" r="2" /><path d="M9 7V4h3v3M10.5 4V2.5" /></>)}
  {name === 'handheld' && (<><rect x="7" y="3" width="10" height="7" rx="2" /><circle cx="12" cy="6.5" r="1.6" /><path d="M10 10l-1 11h4l1-11" /></>)}
  {name === 'drone' && (<><rect x="9" y="10" width="6" height="4" rx="1" /><path d="M9 11 5 8M15 11l4-3M9 13l-4 3M15 13l4 3" /><path d="M2.5 8h5M16.5 8h5M2.5 16h5M16.5 16h5" /><path d="M12 14v3" /></>)}
  {name === 'gnss' && (<><path d="M12 13v8M9 21h6" /><circle cx="12" cy="11" r="2" /><path d="M8 7a5.5 5.5 0 0 1 8 0M5.5 4.5a9 9 0 0 1 13 0" /></>)}
  {name === 'totalstation' && (<><rect x="8" y="4" width="8" height="7" rx="1.5" /><path d="M12 7.5h.01M6 7.5h2M12 11v3M12 14l-5 7M12 14l5 7M12 14v7" /></>)}
  {name === 'computer' && (<><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /><path d="M7 12l3-3 2 2 4-4" /></>)}
</svg>
