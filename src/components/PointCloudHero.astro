---
// Animated, rotating "LiDAR scan" of a cable-stayed bridge drawn on a canvas.
// Purely decorative; respects prefers-reduced-motion.
---

<canvas id="pointcloud" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('pointcloud') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    type P = [number, number, number];
    const pts: P[] = [];
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const jitter = () => rand(-0.012, 0.012);

    // Deck (length along x, width along z)
    for (let i = 0; i < 1400; i++) pts.push([rand(-1.6, 1.6), jitter(), rand(-0.18, 0.18)]);
    // Two pylons
    for (const px of [-0.7, 0.7]) {
      for (const pz of [-0.16, 0.16]) {
        for (let i = 0; i < 160; i++) pts.push([px + jitter(), rand(0, 0.9), pz + jitter()]);
      }
      // Piers below deck
      for (let i = 0; i < 120; i++) pts.push([px + rand(-0.06, 0.06), rand(-0.55, 0), rand(-0.12, 0.12)]);
      // Stay cables (fan)
      for (let c = 1; c <= 7; c++) {
        for (const dir of [-1, 1]) {
          const ex = px + dir * c * 0.11;
          const top = 0.9 - c * 0.025;
          for (const pz of [-0.16, 0.16]) {
            for (let i = 0; i < 26; i++) {
              const t = i / 25;
              pts.push([px + (ex - px) * t, top * (1 - t), pz]);
            }
          }
        }
      }
    }
    // Abutments / end piers
    for (const px of [-1.6, 1.6]) for (let i = 0; i < 80; i++) pts.push([px + jitter(), rand(-0.55, 0), rand(-0.15, 0.15)]);
    // Ground / water plane
    for (let i = 0; i < 1500; i++) {
      const x = rand(-2.2, 2.2), z = rand(-1.2, 1.2);
      pts.push([x, -0.55 + Math.sin(x * 3) * 0.02 + Math.cos(z * 4) * 0.02, z]);
    }

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, dpr = 1, angle = 0.6, pointerX = 0, raf = 0;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const color = (y: number) => {
      // height ramp: deep blue -> teal -> amber
      const t = Math.min(1, Math.max(0, (y + 0.55) / 1.45));
      const stops = [[51, 92, 166], [20, 184, 166], [245, 165, 36]];
      const s = t < 0.5 ? 0 : 1, k = t < 0.5 ? t / 0.5 : (t - 0.5) / 0.5;
      const a = stops[s], b = stops[s + 1];
      return `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * k)).join(',')})`;
    };
    const colors = pts.map((p) => color(p[1]));

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const a = angle + pointerX * 0.4;
      const cos = Math.cos(a), sin = Math.sin(a);
      const tilt = 0.32, ct = Math.cos(tilt), st = Math.sin(tilt);
      const scale = Math.min(w * (w > 900 ? 0.55 : 0.9), h * 1.3) * 0.32;
      const cx = w * (w > 900 ? 0.72 : 0.5), cy = h * (w > 900 ? 0.58 : 0.72);

      for (let i = 0; i < pts.length; i++) {
        const [x, y, z] = pts[i];
        const rx = x * cos - z * sin;
        const rz = x * sin + z * cos;
        const ry = y * ct - rz * st;
        const rz2 = y * st + rz * ct;
        const persp = 3 / (3 + rz2);
        const sx = cx + rx * scale * persp;
        const sy = cy - ry * scale * persp;
        ctx.globalAlpha = Math.max(0.3, Math.min(1, 0.95 - rz2 * 0.3));
        ctx.fillStyle = colors[i];
        const r = 2 * persp;
        ctx.fillRect(sx, sy, r, r);
      }
      ctx.globalAlpha = 1;
    };

    const loop = () => {
      angle += 0.0025;
      draw();
      raf = requestAnimationFrame(loop);
    };

    resize();
    window.addEventListener('resize', () => { resize(); if (reduced) draw(); });
    if (reduced) draw();
    else {
      window.addEventListener('pointermove', (e) => { pointerX = e.clientX / window.innerWidth - 0.5; }, { passive: true });
      const vis = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { if (!raf) loop(); } else { cancelAnimationFrame(raf); raf = 0; }
      });
      vis.observe(canvas);
    }
  }
</script>
