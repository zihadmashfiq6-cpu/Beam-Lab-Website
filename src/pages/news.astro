---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import news from '../data/news.json';

const items = [...news].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Layout title="News" description="Announcements, awards, and updates from BEaM Lab.">
  <PageHeader eyebrow="News" title="Lab news & updates" />

  <section class="py-20">
    <div class="container-x max-w-3xl">
      <ol class="relative border-l-2 border-slate-200 dark:border-white/10">
        {items.map((n) => (
          <li class="reveal relative mb-12 pl-8 last:mb-0">
            <span class="absolute top-1.5 -left-[9px] h-4 w-4 rounded-full border-4 border-white bg-signal-500 dark:border-navy-950" aria-hidden="true"></span>
            <div class="flex items-center gap-3 text-sm">
              <time datetime={n.date} class="font-semibold text-navy-700 dark:text-signal-400">{fmt(n.date)}</time>
              <span class="chip">{n.tag}</span>
            </div>
            <h2 class="mt-2 text-xl font-semibold">{n.title}</h2>
            <p class="mt-2 leading-relaxed">{n.summary}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
