---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import projects from '../../data/projects.json';
import research from '../../data/research.json';
import { url } from '../../lib/url';

const areaName = (slug: string) => research.find((r) => r.slug === slug)?.title ?? '';
---

<Layout title="Projects" description="Current and past research projects at BEaM Lab.">
  <PageHeader eyebrow="Projects" title="What we're working on" intro="Sponsored research with transportation agencies, industry, and our own campus." />

  <section class="py-20">
    <div class="container-x grid gap-8 md:grid-cols-2">
      {projects.map((p, i) => (
        <a href={url(`/projects/${p.slug}`)} class="card reveal group overflow-hidden" style={`transition-delay:${(i % 2) * 80}ms`}>
          <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-navy-700 to-navy-950">
            {p.image ? (
              <img src={url(p.image)} alt={p.title} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
            ) : (
              <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
            )}
            <span class:list={['chip absolute top-4 left-4', p.status === 'Active' ? '!bg-signal-500 !text-navy-950' : '!bg-white/20 !text-white']}>{p.status}</span>
          </div>
          <div class="p-7">
            <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">{areaName(p.area)} · {p.years}</p>
            <h2 class="mt-2 text-xl font-semibold leading-snug group-hover:text-navy-600 dark:group-hover:text-signal-400">{p.title}</h2>
            <p class="mt-3 leading-relaxed">{p.summary}</p>
            <p class="mt-5 text-sm font-semibold text-navy-600 dark:text-signal-400">View project →</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
