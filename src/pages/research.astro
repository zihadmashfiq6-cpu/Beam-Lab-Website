---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ResearchIcon from '../components/ResearchIcon.astro';
import research from '../data/research.json';
import projects from '../data/projects.json';
import { url } from '../lib/url';
---

<Layout title="Research" description="Research areas at BEaM Lab: reality capture, intelligent infrastructure, digital twins, and construction automation.">
  <PageHeader eyebrow="Research" title="Turning field data into engineering insight" intro="Our work spans the full pipeline — from collecting 3D data in the field to the algorithms and tools that help engineers act on it." />

  <section class="py-20">
    <div class="container-x space-y-20">
      {research.map((r, i) => {
        const related = projects.filter((p) => p.area === r.slug);
        return (
          <article id={r.slug} class="reveal grid scroll-mt-24 items-center gap-10 md:grid-cols-2">
            <div class:list={['relative aspect-[4/3] overflow-hidden rounded-3xl bg-gradient-to-br from-navy-700 to-navy-950', i % 2 === 1 && 'md:order-2']}>
              <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
              <div class="absolute inset-0 flex items-center justify-center text-signal-400/80">
                <ResearchIcon name={r.icon} class="h-28 w-28" />
              </div>
              <p class="absolute bottom-4 left-4 text-xs text-white/50">Image placeholder</p>
            </div>
            <div>
              <p class="eyebrow">Area {String(i + 1).padStart(2, '0')}</p>
              <h2 class="mt-3 text-3xl font-bold">{r.title}</h2>
              <p class="mt-4 text-lg leading-relaxed">{r.description}</p>
              {related.length > 0 && (
                <div class="mt-6">
                  <p class="text-sm font-semibold text-navy-900 dark:text-white">Related projects</p>
                  <ul class="mt-2 space-y-1">
                    {related.map((p) => (
                      <li><a href={url(`/projects/${p.slug}`)} class="text-navy-600 hover:text-signal-600 dark:text-signal-400">→ {p.title}</a></li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
