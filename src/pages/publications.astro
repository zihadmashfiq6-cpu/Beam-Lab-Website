---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import publications from '../data/publications.json';

const pubs = [...publications].sort((a, b) => b.year - a.year);
const years = [...new Set(pubs.map((p) => p.year))];
const topics = [...new Set(pubs.flatMap((p) => p.topics))].sort();
---

<Layout title="Publications" description="Journal articles, conference papers, and reports from BEaM Lab.">
  <PageHeader eyebrow="Publications" title="Papers & reports" intro="Filter by year or topic. Links go to the publisher or DOI when available." />

  <section class="py-16">
    <div class="container-x">
      <div class="reveal flex flex-col gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:flex-row sm:items-end dark:border-white/10 dark:bg-navy-900/60">
        <label class="flex-1">
          <span class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Search</span>
          <input id="pub-search" type="search" placeholder="Title, author, venue…" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-white/15 dark:bg-navy-950" />
        </label>
        <label>
          <span class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Year</span>
          <select id="pub-year" class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 sm:w-36 dark:border-white/15 dark:bg-navy-950">
            <option value="">All years</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </label>
        <label>
          <span class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Topic</span>
          <select id="pub-topic" class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 sm:w-44 dark:border-white/15 dark:bg-navy-950">
            <option value="">All topics</option>
            {topics.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
      </div>

      <p id="pub-count" class="mt-6 text-sm text-slate-500" aria-live="polite"></p>

      <ol id="pub-list" class="mt-4 space-y-4">
        {pubs.map((p) => {
          const href = p.doi ? `https://doi.org/${p.doi}` : p.link;
          return (
            <li
              class="card p-6 hover:translate-y-0"
              data-year={p.year}
              data-topics={p.topics.join('|')}
              data-text={`${p.title} ${p.authors} ${p.venue}`.toLowerCase()}
            >
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="font-display text-sm font-bold text-signal-600 dark:text-signal-400">{p.year}</span>
                <span class="chip">{p.type}</span>
                {p.topics.map((t) => <span class="chip !bg-transparent ring-1 ring-slate-300 dark:ring-white/20">{t}</span>)}
              </div>
              <h2 class="mt-3 text-lg font-semibold leading-snug">
                {href ? <a href={href} target="_blank" rel="noopener" class="hover:text-navy-600 dark:hover:text-signal-400">{p.title}</a> : p.title}
              </h2>
              <p class="mt-1 text-sm">{p.authors}</p>
              <p class="text-sm italic text-slate-500 dark:text-slate-400">{p.venue}</p>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
</Layout>

<script>
  const search = document.getElementById('pub-search') as HTMLInputElement;
  const year = document.getElementById('pub-year') as HTMLSelectElement;
  const topic = document.getElementById('pub-topic') as HTMLSelectElement;
  const count = document.getElementById('pub-count')!;
  const items = [...document.querySelectorAll<HTMLElement>('#pub-list > li')];

  const apply = () => {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const ok =
        (!year.value || li.dataset.year === year.value) &&
        (!topic.value || li.dataset.topics!.split('|').includes(topic.value)) &&
        (!q || li.dataset.text!.includes(q));
      li.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = `Showing ${shown} of ${items.length} publications`;
  };
  [search, year, topic].forEach((el) => el.addEventListener('input', apply));
  apply();
</script>
