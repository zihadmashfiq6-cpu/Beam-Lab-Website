---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import InstrumentIcon from '../components/InstrumentIcon.astro';
import instruments from '../data/instruments.json';
import projects from '../data/projects.json';
import { url } from '../lib/url';

const categories = [...new Set(instruments.map((i) => i.category))];
const projectTitle = (slug: string) => projects.find((p) => p.slug === slug)?.title;
---

<Layout title="Instruments" description="Laser scanners, drones, surveying equipment, and computing resources used in BEaM Lab research projects.">
  <PageHeader eyebrow="Instruments" title="The tools behind our data" intro="From tripod scanners to vehicle-mounted and airborne LiDAR, here is the equipment we use to capture and process the built environment." />

  <section class="py-16">
    <div class="container-x">
      <div class="reveal flex flex-wrap gap-2" role="group" aria-label="Filter by category">
        <button type="button" data-filter="" class="filter-btn is-active">All</button>
        {categories.map((c) => <button type="button" data-filter={c} class="filter-btn">{c}</button>)}
      </div>

      <div id="instrument-grid" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {instruments.map((ins, i) => (
          <article id={ins.slug} data-category={ins.category} class="card reveal flex scroll-mt-24 flex-col overflow-hidden" style={`transition-delay:${(i % 3) * 80}ms`}>
            <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-navy-700 to-navy-950">
              {ins.image ? (
                <img src={url(ins.image)} alt={ins.name} class="h-full w-full object-cover" loading="lazy" />
              ) : (
                <>
                  <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
                  <div class="absolute inset-0 flex items-center justify-center text-signal-400/80">
                    <InstrumentIcon name={ins.icon} class="h-20 w-20" />
                  </div>
                </>
              )}
              <span class="chip absolute top-4 left-4 !bg-white/15 !text-white backdrop-blur">{ins.category}</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-lg font-semibold">{ins.name}</h2>
              <p class="text-sm text-slate-500 dark:text-slate-400">{ins.model}</p>
              <p class="mt-3 text-sm leading-relaxed">{ins.description}</p>

              <dl class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 text-sm dark:divide-white/10 dark:border-white/10">
                {Object.entries(ins.specs).map(([k, v]) => (
                  <div class="flex justify-between gap-4 px-3 py-2">
                    <dt class="text-slate-500 dark:text-slate-400">{k}</dt>
                    <dd class="text-right font-medium text-navy-900 dark:text-white">{v}</dd>
                  </div>
                ))}
              </dl>

              {ins.usedIn.length > 0 && (
                <div class="mt-auto pt-5">
                  <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">Used in</p>
                  <ul class="mt-2 flex flex-wrap gap-2">
                    {ins.usedIn.map((slug) => projectTitle(slug) && (
                      <li><a href={url(`/projects/${slug}`)} class="chip hover:!bg-signal-500 hover:!text-navy-950">{projectTitle(slug)}</a></li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .filter-btn {
    border-radius: 9999px;
    border: 1px solid var(--color-slate-300);
    padding: 0.4rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .filter-btn:hover { border-color: var(--color-signal-500); }
  .filter-btn.is-active {
    background: var(--color-signal-500);
    border-color: var(--color-signal-500);
    color: var(--color-navy-950);
  }
  :global(.dark) .filter-btn:not(.is-active) { border-color: rgb(255 255 255 / 0.2); color: white; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#instrument-grid > article');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const f = btn.dataset.filter;
      cards.forEach((c) => (c.hidden = !!f && c.dataset.category !== f));
    }),
  );
</script>
