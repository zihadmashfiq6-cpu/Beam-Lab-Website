---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';

const mapQuery = encodeURIComponent('Carruth Building, Georgia Southern University, Statesboro, GA');
---

<Layout title="Contact" description="Get in touch with BEaM Lab at Georgia Southern University.">
  <PageHeader eyebrow="Contact" title="Get in touch" intro="Interested in joining the lab, collaborating, or sponsoring research? We'd love to hear from you." />

  <section class="py-20">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div class="reveal space-y-6">
        <div class="card p-7 hover:translate-y-0">
          <h2 class="text-lg font-semibold">Visit</h2>
          <address class="mt-2 not-italic leading-relaxed">
            {site.name}<br />{site.department}<br />
            {site.address.map((l) => (<>{l}<br /></>))}
          </address>
        </div>
        <div class="card p-7 hover:translate-y-0">
          <h2 class="text-lg font-semibold">Email & phone</h2>
          <p class="mt-2"><a href={`mailto:${site.email}`} class="font-semibold text-navy-600 hover:text-signal-600 dark:text-signal-400">{site.email}</a></p>
          <p class="mt-1">{site.phone}</p>
        </div>
        <div class="card p-7 hover:translate-y-0">
          <h2 class="text-lg font-semibold">Prospective students</h2>
          <p class="mt-2 leading-relaxed">Email us your CV, a short statement of research interests, and your expected start term. Please include “Prospective Student” in the subject line.</p>
        </div>
      </div>
      <div class="reveal overflow-hidden rounded-2xl border border-slate-200 dark:border-white/10">
        <iframe
          title="Map showing the Carruth Building at Georgia Southern University"
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          class="h-full min-h-96 w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
